/// <summary>
/// Three-operation JSON service over the existing UBHR_Nive tables.
/// Portal timestamps, documents, consent, retry state and model metadata are
/// retained by the authenticated FastAPI backend in SQLite, not copied here.
/// All operations execute in the integration user's configured current company.
/// </summary>
public final class UBHRPortalService
{
    [SysEntryPointAttribute(true)]
    public UBHRPortalRequirementsContract getOpenRequirements()
    {
        UBJobRequirementTable requirement;
        UBHRPortalRequirementsContract result = new UBHRPortalRequirementsContract();
        List records = new List(Types::Class);
        date today = DateTimeUtil::date(DateTimeUtil::utcNow());

        // POST {}. D365_COMPANY must match the integration user's current
        // legal entity. No cross-company query is performed.
        while select requirement
            order by requirement.RequirementId
        {
            if (this.acceptsApplications(requirement, today))
            {
                records.addEnd(this.requirementContract(requirement));
            }
        }
        result.parmRequirements(records);
        return result;
    }

    [SysEntryPointAttribute(true)]
    public UBHRPortalResultContract submitApplication(UBHRPortalApplicationRequestContract _request)
    {
        UBJobRequirementTable requirement;
        UBCandidateTable candidate;
        UBJobApplicationTable application;
        UBHRPortalResultContract result;
        str identityKey;
        str candidateName;
        int attempts;

        if (!_request)
        {
            throw error("The _request parameter is required.");
        }
        this.requireCompany(_request.parmCompany());
        candidateName = this.requestCandidateName(_request);
        this.requireExternalId(_request.parmApplicationId(), "APP-", "ApplicationId");
        this.requireFieldText(application, fieldNum(UBJobApplicationTable, ApplicationId), _request.parmApplicationId());
        this.requireFieldText(requirement, fieldNum(UBJobRequirementTable, RequirementId), _request.parmRequirementId());
        this.requireFieldText(application, fieldNum(UBJobApplicationTable, RequirementId), _request.parmRequirementId());
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, CandidateName), candidateName);
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, Email), _request.parmEmail());
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, Phone), _request.parmPhone(), false);
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, LinkedInProfileUrl), _request.parmLinkedInProfileUrl(), false);
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, LinkedInIssuer), _request.parmLinkedInIssuer());
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, LinkedInSub), _request.parmLinkedInSub());
        this.requireEmail(_request.parmEmail());
        this.requireLinkedInUrl(_request.parmLinkedInProfileUrl());
        identityKey = this.identityHash(_request.parmLinkedInIssuer(), _request.parmLinkedInSub());
        this.requireFieldText(candidate, fieldNum(UBCandidateTable, IdentityKey), identityKey);

        try
        {
            ttsBegin;
            // SQLite freezes ApplicationId before its first HTTP attempt. A
            // unique DB index makes a lost acknowledgement retry the same row.
            application.concurrencyModel(ConcurrencyModel::Pessimistic);
            select firstOnly forUpdate application
                where application.ApplicationId == _request.parmApplicationId();
            if (application.RecId)
            {
                select firstOnly candidate
                    where candidate.CandidateId == application.CandidateId;
                if (!this.sameText(application.ApplicationId, _request.parmApplicationId())
                    || !this.sameText(application.RequirementId, _request.parmRequirementId())
                    || !candidate.RecId
                    || !this.sameText(candidate.LinkedInIssuer, _request.parmLinkedInIssuer())
                    || !this.sameText(candidate.LinkedInSub, _request.parmLinkedInSub())
                    || !this.sameText(candidate.IdentityKey, identityKey))
                {
                    throw error("ApplicationId is already assigned to a different requirement or identity.");
                }
                // Recover even after job closure. SQLite verifies immutable
                // payloads; retries must not overwrite the current contacts.
                result = this.applicationResult(application, "Application was already accepted.");
                ttsCommit;
                return result;
            }

            requirement.concurrencyModel(ConcurrencyModel::Pessimistic);
            select firstOnly forUpdate requirement
                where requirement.RequirementId == _request.parmRequirementId();
            if (!requirement.RecId
                || !this.sameText(requirement.RequirementId, _request.parmRequirementId())
                || !this.acceptsApplications(requirement, DateTimeUtil::date(DateTimeUtil::utcNow())))
            {
                throw error("The requirement is not accepting applications.");
            }

            candidate.concurrencyModel(ConcurrencyModel::Pessimistic);
            select firstOnly forUpdate candidate
                where candidate.IdentityKey == identityKey;
            if (candidate.RecId)
            {
                // Short hash index plus ordinal verification of the original
                // issuer/subject pair avoids SQL collation identity confusion.
                if (!this.sameText(candidate.IdentityKey, identityKey)
                    || !this.sameText(candidate.LinkedInIssuer, _request.parmLinkedInIssuer())
                    || !this.sameText(candidate.LinkedInSub, _request.parmLinkedInSub()))
                {
                    throw error("The candidate identity key does not match its stored identity.");
                }
            }
            else
            {
                candidate.clear();
                candidate.initValue();
                this.writeText(candidate, fieldNum(UBCandidateTable, CandidateId), this.externalId("CAN-"));
                this.writeText(candidate, fieldNum(UBCandidateTable, IdentityKey), identityKey);
                this.writeText(candidate, fieldNum(UBCandidateTable, LinkedInIssuer), _request.parmLinkedInIssuer());
                this.writeText(candidate, fieldNum(UBCandidateTable, LinkedInSub), _request.parmLinkedInSub());
            }
            // Retain existing business defaults; write no provider JSON,
            // consent, blob, document digest or portal timestamp metadata.
            this.writeText(candidate, fieldNum(UBCandidateTable, CandidateName), candidateName);
            // Only legacy callers supply these. Never guess name components
            // by splitting a person's full name.
            if (!strLen(strLRTrim(_request.parmCandidateName())))
            {
                this.writeText(candidate, fieldNum(UBCandidateTable, FirstName), _request.parmFirstName());
                this.writeText(candidate, fieldNum(UBCandidateTable, LastName), _request.parmLastName(), false);
            }
            this.writeText(candidate, fieldNum(UBCandidateTable, Email), _request.parmEmail());
            this.writeText(candidate, fieldNum(UBCandidateTable, Phone), _request.parmPhone(), false);
            this.writeText(candidate, fieldNum(UBCandidateTable, LinkedInProfileUrl), _request.parmLinkedInProfileUrl(), false);
            if (!candidate.validateWrite())
            {
                throw error("The candidate record could not be validated. Check the existing table's business defaults.");
            }
            if (candidate.RecId)
            {
                candidate.update();
            }
            else
            {
                candidate.insert();
            }

            application.clear();
            application.initValue();
            this.writeText(application, fieldNum(UBJobApplicationTable, ApplicationId), _request.parmApplicationId());
            this.writeText(application, fieldNum(UBJobApplicationTable, CandidateId), candidate.CandidateId);
            this.writeText(application, fieldNum(UBJobApplicationTable, RequirementId), requirement.RequirementId);
            // Populate before insert(): the screening event copies this name.
            this.writeText(application, fieldNum(UBJobApplicationTable, CandidateName), candidateName);
            // Preserve ApplicationStatus from existing initValue() defaults.
            this.writeSymbol(application, fieldNum(UBJobApplicationTable, AIStatus), this.pendingAIStatus());
            application.OverallScore = 0;
            if (!application.validateWrite())
            {
                throw error("The application record could not be validated. Check the existing table's business defaults.");
            }
            application.insert();
            result = this.applicationResult(application, "Application accepted; evaluation is pending.");
            ttsCommit;
            return result;
        }
        catch (Exception::DuplicateKeyException)
        {
            attempts++;
            if (attempts >= 3)
            {
                throw error("Concurrent submission could not be resolved. Retry with the same ApplicationId.");
            }
            retry;
        }
        catch (Exception::UpdateConflict)
        {
            attempts++;
            if (attempts >= 3)
            {
                throw error("Concurrent submission update could not be resolved. Retry with the same ApplicationId.");
            }
            retry;
        }
    }

    [SysEntryPointAttribute(true)]
    public UBHRPortalResultContract saveCandidateEvaluation(UBHRPortalEvaluationRequestContract _request)
    {
        UBJobApplicationTable application;
        UBHRMatchEvaluationTable evaluation;
        UBHRPortalResultContract result;
        int attempts;

        if (!_request)
        {
            throw error("The _request parameter is required.");
        }
        this.requireCompany(_request.parmCompany());
        this.requireExternalId(_request.parmApplicationId(), "APP-", "ApplicationId");
        this.requireExternalId(_request.parmEvaluationId(), "EVA-", "EvaluationId");
        this.requireFieldText(application, fieldNum(UBJobApplicationTable, ApplicationId), _request.parmApplicationId());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, EvaluationId), _request.parmEvaluationId());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, ApplicationId), _request.parmApplicationId());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, RequirementId), _request.parmRequirementId());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, MatchLabel), _request.parmMatchLabel());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, Summary), _request.parmSummary());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, MatchedSkillsJson), _request.parmMatchedSkillsJson());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, MissingSkillsJson), _request.parmMissingSkillsJson());
        this.requireFieldText(evaluation, fieldNum(UBHRMatchEvaluationTable, EvidenceJson), _request.parmEvidenceJson());
        if (_request.parmScore() < 0 || _request.parmScore() > 100)
        {
            throw error("Score must be between 0 and 100.");
        }
        this.requireJsonArray(_request.parmMatchedSkillsJson(), "MatchedSkillsJson");
        this.requireJsonArray(_request.parmMissingSkillsJson(), "MissingSkillsJson");
        this.requireJsonArray(_request.parmEvidenceJson(), "EvidenceJson");

        try
        {
            ttsBegin;
            // All writers lock the parent first, serializing evaluation saves
            // for this application and keeping one current evaluation row.
            application.concurrencyModel(ConcurrencyModel::Pessimistic);
            select firstOnly forUpdate application
                where application.ApplicationId == _request.parmApplicationId();
            if (!application.RecId
                || !this.sameText(application.ApplicationId, _request.parmApplicationId())
                || !this.sameText(application.RequirementId, _request.parmRequirementId()))
            {
                throw error("ApplicationId and RequirementId must identify the same existing application.");
            }

            evaluation.concurrencyModel(ConcurrencyModel::Pessimistic);
            select firstOnly forUpdate evaluation
                where evaluation.EvaluationId == _request.parmEvaluationId();
            if (evaluation.RecId
                && (!this.sameText(evaluation.EvaluationId, _request.parmEvaluationId())
                    || !this.sameText(evaluation.ApplicationId, application.ApplicationId)
                    || !this.sameText(evaluation.RequirementId, application.RequirementId)))
            {
                throw error("EvaluationId is already assigned to a different application or requirement.");
            }
            if (!evaluation.RecId)
            {
                evaluation.concurrencyModel(ConcurrencyModel::Pessimistic);
                select firstOnly forUpdate evaluation
                    where evaluation.ApplicationId == application.ApplicationId;
                if (evaluation.RecId && !this.sameText(evaluation.EvaluationId, _request.parmEvaluationId()))
                {
                    throw error("Use the same stable EvaluationId when updating an application's current evaluation.");
                }
            }
            if (evaluation.RecId && !this.sameText(evaluation.RequirementId, application.RequirementId))
            {
                throw error("The existing evaluation has an inconsistent requirement reference.");
            }

            if (!evaluation.RecId || !this.sameEvaluation(evaluation, _request))
            {
                if (!evaluation.RecId)
                {
                    evaluation.clear();
                    evaluation.initValue();
                    this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, EvaluationId), _request.parmEvaluationId());
                    this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, ApplicationId), application.ApplicationId);
                    this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, RequirementId), application.RequirementId);
                }
                // Preserve exact score including zero. Partial matches,
                // confidence, justification, model/version and dates remain
                // in SQLite. No metadata-only D365 fields are written.
                evaluation.Score = _request.parmScore();
                this.writeBoolean(evaluation, fieldNum(UBHRMatchEvaluationTable, MeetsMinimumCriteria), _request.parmMeetsMinimumCriteria());
                this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, MatchLabel), _request.parmMatchLabel());
                this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, Summary), _request.parmSummary());
                this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, MatchedSkillsJson), _request.parmMatchedSkillsJson());
                this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, MissingSkillsJson), _request.parmMissingSkillsJson());
                this.writeText(evaluation, fieldNum(UBHRMatchEvaluationTable, EvidenceJson), _request.parmEvidenceJson());
                if (!evaluation.validateWrite())
                {
                    throw error("The evaluation record could not be validated. Check the existing table's business defaults.");
                }
                if (evaluation.RecId)
                {
                    evaluation.update();
                }
                else
                {
                    evaluation.insert();
                }
            }

            // The evaluation, OverallScore and AIStatus commit atomically.
            // Never change a human ApplicationStatus based on AI evidence.
            if (application.OverallScore != _request.parmScore()
                || !this.sameText(this.readSymbol(application, fieldNum(UBJobApplicationTable, AIStatus)), this.completedAIStatus()))
            {
                application.OverallScore = _request.parmScore();
                this.writeSymbol(application, fieldNum(UBJobApplicationTable, AIStatus), this.completedAIStatus());
                if (!application.validateWrite())
                {
                    throw error("The completed application record could not be validated.");
                }
                application.update();
            }
            result = this.applicationResult(application, "Current evaluation saved.");
            result.parmEvaluationId(evaluation.EvaluationId);
            ttsCommit;
            return result;
        }
        catch (Exception::DuplicateKeyException)
        {
            attempts++;
            if (attempts >= 3)
            {
                throw error("Concurrent evaluation could not be resolved. Retry with the same EvaluationId.");
            }
            retry;
        }
        catch (Exception::UpdateConflict)
        {
            attempts++;
            if (attempts >= 3)
            {
                throw error("Concurrent evaluation update could not be resolved. Retry with the same EvaluationId.");
            }
            retry;
        }
    }

    // Configure actual enum element names (symbols), not translated labels or
    // guessed numeric values. For strings use the existing stored text.
    private FieldId requirementStatusFieldId()
    {
        return fieldNum(UBJobRequirementTable, RequirementStatus);
    }

    private str openRequirementStatus()
    {
        return "Open";
    }

    private str pendingAIStatus()
    {
        return "Pending";
    }

    private str completedAIStatus()
    {
        return "Completed";
    }

    private boolean acceptsApplications(UBJobRequirementTable _requirement, date _today)
    {
        return this.sameText(this.readSymbol(_requirement, this.requirementStatusFieldId()), this.openRequirementStatus())
            && (_requirement.OpenDate == dateNull() || _requirement.OpenDate <= _today)
            && (_requirement.CloseDate == dateNull() || _requirement.CloseDate >= _today);
    }

    private UBHRPortalRequirementContract requirementContract(UBJobRequirementTable _requirement)
    {
        UBHRPortalRequirementContract result = new UBHRPortalRequirementContract();
        result.parmRequirementId(_requirement.RequirementId);
        result.parmJobTitle(_requirement.JobTitle);
        result.parmJobDescription(_requirement.JobDescription);
        result.parmResponsibilities(_requirement.Responsibilities);
        result.parmRequiredSkills(_requirement.RequiredSkills);
        result.parmPreferredSkills(_requirement.PreferredSkills);
        result.parmRequiredQualifications(_requirement.RequiredQualifications);
        result.parmRequiredCertifications(_requirement.RequiredCertifications);
        result.parmDepartment(_requirement.Department);
        result.parmJobLocation(_requirement.JobLocation);
        result.parmWorkMode(this.readSymbol(_requirement, fieldNum(UBJobRequirementTable, WorkMode)));
        result.parmEmploymentType(this.readSymbol(_requirement, fieldNum(UBJobRequirementTable, EmploymentType)));
        result.parmMinimumExperienceYears(_requirement.MinimumExperienceYears);
        result.parmMaximumExperienceYears(_requirement.MaximumExperienceYears);
        result.parmNumberOfOpenings(_requirement.NumberOfOpenings);
        // Eligible rows are canonical Open jobs on the portal even when the
        // existing F&O status symbol is configured as Active/Approved/etc.
        result.parmRequirementStatus("Open");
        result.parmOpenDate(this.dateText(_requirement.OpenDate));
        result.parmCloseDate(this.dateText(_requirement.CloseDate));
        if (_requirement.EvaluationCriteriaJson)
        {
            result.parmEvaluationCriteriaJson(_requirement.EvaluationCriteriaJson);
        }
        result.parmRubricVersion(_requirement.RubricVersion);
        return result;
    }

    private UBHRPortalResultContract applicationResult(UBJobApplicationTable _application, str _message)
    {
        UBHRPortalResultContract result = new UBHRPortalResultContract();
        result.parmSuccess(true);
        result.parmApplicationId(_application.ApplicationId);
        result.parmCandidateId(_application.CandidateId);
        result.parmMessage(_message);
        return result;
    }

    private boolean sameEvaluation(UBHRMatchEvaluationTable _evaluation, UBHRPortalEvaluationRequestContract _request)
    {
        return _evaluation.Score == _request.parmScore()
            && this.readBoolean(_evaluation, fieldNum(UBHRMatchEvaluationTable, MeetsMinimumCriteria)) == _request.parmMeetsMinimumCriteria()
            && this.sameText(_evaluation.MatchLabel, _request.parmMatchLabel())
            && this.sameText(_evaluation.Summary, _request.parmSummary())
            && this.sameText(_evaluation.MatchedSkillsJson, _request.parmMatchedSkillsJson())
            && this.sameText(_evaluation.MissingSkillsJson, _request.parmMissingSkillsJson())
            && this.sameText(_evaluation.EvidenceJson, _request.parmEvidenceJson());
    }

    private str requestCandidateName(UBHRPortalApplicationRequestContract _request)
    {
        str name = strLRTrim(_request.parmCandidateName());

        if (!strLen(name))
        {
            // Compatibility for the previous portal contract, not a split of
            // the new CandidateName input.
            name = strLRTrim(strFmt("%1 %2", _request.parmFirstName(), _request.parmLastName()));
        }
        return name;
    }

    private void requireCompany(str _company)
    {
        if (!_company || !System.String::Equals(_company, curExt(), System.StringComparison::OrdinalIgnoreCase))
        {
            throw error("Company must match the integration user's configured current company.");
        }
    }

    private void requireExternalId(str _value, str _prefix, str _field)
    {
        if (!System.Text.RegularExpressions.Regex::IsMatch(
            _value, "^" + _prefix + "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"))
        {
            throw error(strFmt("%1 must contain the stable %2 identifier supplied by the backend.", _field, _prefix));
        }
    }

    private void requireFieldText(Common _record, FieldId _fieldId, str _value, boolean _required = true)
    {
        DictField field = new DictField(_record.TableId, _fieldId);
        boolean evaluationMemo;
        int maximumLength;
        // These four business fields are Memo in the deployed UBHR model.
        // Their base type can differ from a fixed-length string EDT.
        evaluationMemo = _record.TableId == tableNum(UBHRMatchEvaluationTable)
            && (_fieldId == fieldNum(UBHRMatchEvaluationTable, Summary)
                || _fieldId == fieldNum(UBHRMatchEvaluationTable, MatchedSkillsJson)
                || _fieldId == fieldNum(UBHRMatchEvaluationTable, MissingSkillsJson)
                || _fieldId == fieldNum(UBHRMatchEvaluationTable, EvidenceJson));
        if (!field || (!evaluationMemo && field.baseType() != Types::String))
        {
            throw error(strFmt("%1.%2 must be a string field for this service mapping.", tableId2Name(_record.TableId), fieldId2Name(_record.TableId, _fieldId)));
        }
        maximumLength = evaluationMemo ? 1048576 : field.stringLen();
        if ((_required && !strLen(strLRTrim(_value)))
            || (maximumLength > 0 && strLen(_value) > maximumLength))
        {
            // Reject truncation; Memo payloads have an explicit 1 MiB guard.
            throw error(strFmt("%1.%2 is missing or exceeds its existing field length (%3).", tableId2Name(_record.TableId), field.name(), maximumLength));
        }
    }

    private void writeText(Common _record, FieldId _fieldId, str _value, boolean _required = true)
    {
        this.requireFieldText(_record, _fieldId, _value, _required);
        _record.(_fieldId) = _value;
    }

    private str readSymbol(Common _record, FieldId _fieldId)
    {
        DictField field = new DictField(_record.TableId, _fieldId);
        DictEnum enumeration;
        int enumElementIndex;
        int value;
        if (field.baseType() == Types::String)
        {
            return _record.(_fieldId);
        }
        if (field.baseType() == Types::Enum)
        {
            enumeration = new DictEnum(field.enumId());
            value = _record.(_fieldId);
            for (enumElementIndex = 0; enumElementIndex < enumeration.values(); enumElementIndex++)
            {
                if (enumeration.index2Value(enumElementIndex) == value)
                {
                    return enumeration.index2Symbol(enumElementIndex);
                }
            }
            throw error(strFmt("%1.%2 contains an unknown enum value.", tableId2Name(_record.TableId), field.name()));
        }
        throw error(strFmt("%1.%2 must be an enum or string field for the status mapping.", tableId2Name(_record.TableId), field.name()));
    }

    private void writeSymbol(Common _record, FieldId _fieldId, str _symbol)
    {
        DictField field = new DictField(_record.TableId, _fieldId);
        DictEnum enumeration;
        int enumElementIndex;
        if (field.baseType() == Types::String)
        {
            this.writeText(_record, _fieldId, _symbol);
            return;
        }
        if (field.baseType() == Types::Enum)
        {
            enumeration = new DictEnum(field.enumId());
            for (enumElementIndex = 0; enumElementIndex < enumeration.values(); enumElementIndex++)
            {
                if (this.sameText(enumeration.index2Symbol(enumElementIndex), _symbol))
                {
                    _record.(_fieldId) = enumeration.index2Value(enumElementIndex);
                    return;
                }
            }
            throw error(strFmt("Enum %1 has no symbol '%2'. Set the service configuration method to your actual existing enum symbol.", enumeration.name(), _symbol));
        }
        throw error(strFmt("%1.%2 must be an enum or string field for the status mapping.", tableId2Name(_record.TableId), field.name()));
    }

    private void writeBoolean(Common _record, FieldId _fieldId, boolean _value)
    {
        DictField field = new DictField(_record.TableId, _fieldId);
        if (field.baseType() == Types::Enum)
        {
            this.writeSymbol(_record, _fieldId, _value ? "Yes" : "No");
            return;
        }
        if (field.baseType() == Types::Integer)
        {
            _record.(_fieldId) = _value ? 1 : 0;
            return;
        }
        throw error("MeetsMinimumCriteria must be a NoYes enum or integer field.");
    }

    private boolean readBoolean(Common _record, FieldId _fieldId)
    {
        DictField field = new DictField(_record.TableId, _fieldId);
        str symbol;
        int value;
        if (field.baseType() == Types::Enum)
        {
            symbol = this.readSymbol(_record, _fieldId);
            if (!this.sameText(symbol, "Yes") && !this.sameText(symbol, "No"))
            {
                throw error("MeetsMinimumCriteria must use the existing No/Yes enum symbols.");
            }
            return this.sameText(symbol, "Yes");
        }
        if (field.baseType() == Types::Integer)
        {
            value = _record.(_fieldId);
            if (value != 0 && value != 1)
            {
                throw error("MeetsMinimumCriteria integer value must be 0 or 1.");
            }
            return value == 1;
        }
        throw error("MeetsMinimumCriteria must be a NoYes enum or integer field.");
    }

    private void requireEmail(str _value)
    {
        System.Net.Mail.MailAddress address;
        try
        {
            address = new System.Net.Mail.MailAddress(_value);
        }
        catch (Exception::CLRError)
        {
            throw error("Email must be a contact email address.");
        }
        if (!this.sameText(address.get_Address(), _value))
        {
            throw error("Email must contain only a contact email address.");
        }
    }

    private void requireLinkedInUrl(str _value)
    {
        System.Uri uri;
        if (!_value)
        {
            return;
        }
        try
        {
            uri = new System.Uri(_value, System.UriKind::Absolute);
        }
        catch (Exception::CLRError)
        {
            throw error("LinkedInProfileUrl must be a valid HTTPS LinkedIn profile URL.");
        }
        if (uri.get_Scheme() != "https" || uri.get_UserInfo()
            || !System.Text.RegularExpressions.Regex::IsMatch(uri.get_Host(), "^([a-zA-Z0-9-]+\\.)?linkedin\\.com$"))
        {
            throw error("LinkedInProfileUrl must be a valid HTTPS LinkedIn profile URL.");
        }
    }

    private void requireJsonArray(str _json, str _field)
    {
        Newtonsoft.Json.Linq.JArray array;
        if (strLen(_json) > 1048576)
        {
            throw error(strFmt("%1 exceeds the supported JSON payload size.", _field));
        }
        try
        {
            array = Newtonsoft.Json.Linq.JArray::Parse(_json);
        }
        catch (Exception::CLRError)
        {
            throw error(strFmt("%1 must contain a valid JSON array; use [] for an empty collection.", _field));
        }
    }

    private str dateText(date _value)
    {
        return _value == dateNull() ? "" : date2Str(_value, 321, DateDay::Digits2,
            DateSeparator::Hyphen, DateMonth::Digits2, DateSeparator::Hyphen, DateYear::Digits4);
    }

    private boolean sameText(str _left, str _right)
    {
        return System.String::Equals(_left, _right, System.StringComparison::Ordinal);
    }

    private str externalId(str _prefix)
    {
        System.Guid identifier = System.Guid::NewGuid();
        return _prefix + identifier.ToString("D");
    }

    private str segment(str _value)
    {
        // Character-count length prefixes keep issuer/subject unambiguous;
        // hashing uses UTF-8 and includes the entire original identity pair.
        return int2Str(strLen(_value)) + ":" + _value;
    }

    private str identityHash(str _issuer, str _subject)
    {
        System.Text.Encoding encoding = System.Text.Encoding::get_UTF8();
        System.Security.Cryptography.SHA256 algorithm = System.Security.Cryptography.SHA256::Create();
        System.Byte[] bytes = encoding.GetBytes(this.segment(_issuer) + this.segment(_subject));
        System.Byte[] digest = algorithm.ComputeHash(bytes);
        str result = System.BitConverter::ToString(digest);
        algorithm.Dispose();
        return strLwr(strRem(result, "-"));
    }
}
