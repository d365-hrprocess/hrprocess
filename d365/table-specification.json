  "required_existing_field_properties": {
    "external_ids": "CandidateId, ApplicationId and EvaluationId must store at least 40 characters; references must use compatible lengths. RequirementId must preserve your existing requirement identifier.",
    "identity_key": "IdentityKey must store 64 hexadecimal characters.",
    "long_text": "Existing JD, Summary and evidence JSON fields must preserve complete text; use existing appropriate memo EDTs rather than truncating them.",
