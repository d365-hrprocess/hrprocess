      "table": "UBCandidateTable",
      "screenshot_index": "UBCandidateIdx",
      "fields": [
        "CandidateId"
      ],
      "requirement": "Verify an existing index on CandidateId has AllowDuplicates=No."
    },
    {
      "table": "UBCandidateTable",
      "screenshot_index": "UBIdentityKeyIdx",
      "fields": [
        "IdentityKey"
      ],
      "requirement": "Verify AllowDuplicates=No. Clean old blank/duplicate keys before enabling uniqueness."
    },
    {
      "table": "UBJobApplicationTable",
      "fields": [
        "ApplicationId"
      ],
      "requirement": "Verify an index on ApplicationId has AllowDuplicates=No; retries and concurrent requests depend on it."
    },
    {
      "table": "UBHRMatchEvaluationTable",
      "screenshot_index": "EvaluationIdIdx",
      "fields": [
        "EvaluationId"
      ],
      "requirement": "Verify AllowDuplicates=No; deterministic EvaluationId protects retry writes."
    }
