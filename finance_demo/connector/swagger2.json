  "definitions": {
    "CreateCustomerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_account",
        "organization_name"
      ],
      "properties": {
        "customer_account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^TEST-COPILOT-[A-Za-z0-9._'-]+$",
          "description": "Fresh demo account beginning with TEST-COPILOT-.",
          "example": "TEST-COPILOT-001"
        },
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "example": "Copilot Demo Customer"
        }
      }
    },
    "UpdateCustomerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_name"
      ],
      "properties": {
        "organization_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "example": "Copilot Demo Customer Updated"
        }
      }
    },
    "Customer": {
      "type": "object",
      "required": [
        "customer_account",
        "company"
      ],
      "properties": {
        "customer_account": {
          "type": "string"
        },
        "organization_name": {
          "type": "string",
          "x-nullable": true
        },
        "company": {
          "type": "string",
          "description": "Fixed USMF legal entity."
        },
        "currency": {
          "type": "string",
          "x-nullable": true
        },
        "customer_group": {
          "type": "string",
          "x-nullable": true
        },
        "payment_terms": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "CustomerTransaction": {
      "type": "object",
      "required": [
        "customer_account",
        "company"
      ],
      "properties": {
        "customer_account": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "invoice": {
          "type": "string",
          "x-nullable": true
        },
        "voucher": {
          "type": "string",
          "x-nullable": true
        },
        "transaction_date": {
          "type": "string",
          "x-nullable": true
        },
        "due_date": {
          "type": "string",
          "x-nullable": true
        },
        "amount": {
          "type": "string",
          "x-nullable": true,
          "description": "Exact decimal string from ERP, never a computed full balance.",
          "example": "1250.00"
        },
        "currency": {
          "type": "string",
          "x-nullable": true
        },
        "transaction_type": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "DeletedCustomer": {
      "type": "object",
      "required": [
        "customer_account",
        "company",
        "deleted",
        "verified"
      ],
      "properties": {
        "customer_account": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "deleted": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "ResultMetadata": {
      "type": "object",
      "required": [
        "company"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "limited": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        },
        "returned": {
          "type": "integer",
          "format": "int32"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "CustomerResponse": {
      "type": "object",
      "description": "Customer details or verified create/update result.",
      "required": [
        "success",
        "data",
        "meta"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "$ref": "#/definitions/Customer"
        },
        "meta": {
          "$ref": "#/definitions/ResultMetadata"
        }
      }
    },
    "CustomerListResponse": {
      "type": "object",
      "description": "Limited customer records.",
      "required": [
        "success",
        "data",
        "meta"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Customer"
          }
        },
        "meta": {
          "$ref": "#/definitions/ResultMetadata"
        }
      }
    },
    "TransactionListResponse": {
      "type": "object",
      "description": "Limited customer transaction records; no complete-balance claim.",
      "required": [
        "success",
        "data",
        "meta"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CustomerTransaction"
          }
        },
        "meta": {
          "$ref": "#/definitions/ResultMetadata"
        }
      }
    },
    "DeleteCustomerResponse": {
      "type": "object",
      "description": "JSON confirmation after verified ERP deletion.",
      "required": [
        "success",
        "data",
        "meta"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "data": {
          "$ref": "#/definitions/DeletedCustomer"
        },
        "meta": {
          "$ref": "#/definitions/ResultMetadata"
        }
      }
    },
    "FinanceError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "outcome_uncertain",
        "verification_required"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "outcome_uncertain": {
          "type": "boolean"
        },
        "verification_required": {
          "type": "boolean"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "success",
        "error"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "error": {
          "$ref": "#/definitions/FinanceError"
        }
      }
    }
  }
}
