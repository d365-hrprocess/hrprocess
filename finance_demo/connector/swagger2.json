        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._'-]{0,39}$",
            "description": "Exact customer account in fixed legal entity USMF. Writes require the TEST-COPILOT- prefix."
