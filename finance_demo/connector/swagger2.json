        "x-ms-summary": "List USMF customers",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Maximum number of records returned (1\u201320). Results are limited, not a full history or balance."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
