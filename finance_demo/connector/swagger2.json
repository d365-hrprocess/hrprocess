    "/customers/{account}/transactions": {
      "get": {
        "operationId": "GetFinanceCustomerTransactions",
        "summary": "Read recent customer transactions",
        "description": "Read a bounded list of transactions for an exact USMF customer account. Amounts are decimal strings. The response is limited history, not a complete balance. Transaction capability can be unavailable independently of customer operations.",
        "x-ms-summary": "Read recent customer transactions",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._'-]{0,39}$",
            "description": "Exact customer account in fixed legal entity USMF. Writes require the TEST-COPILOT- prefix."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Maximum number of records returned (1\u201320). Results are limited, not a full history or balance."
          }
        ],
