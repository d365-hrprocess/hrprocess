      "delete": {
        "operationId": "DeleteFinanceCustomer",
        "summary": "Delete a test customer",
        "description": "After explicit user confirmation, delete only an existing TEST-COPILOT- customer. ERP validation and related records may prevent deletion. Never force-delete related data.",
        "x-ms-summary": "Delete a test customer",
