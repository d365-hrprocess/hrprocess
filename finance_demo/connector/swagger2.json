{
  "swagger": "2.0",
  "info": {
    "title": "ubticareers Finance Demo",
    "version": "1.0.0",
    "description": "Temporary D365 Finance customer demo scoped to USMF. Read customers and limited transaction history; modify only TEST-COPILOT- accounts. Confirm every write with the user. No posting, settlement or complete-balance calculation."
  },
  "host": "ubtihrprocess-egg3f7awbsbjdjd5.centralindia-01.azurewebsites.net",
  "basePath": "/finance",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "FinanceDemoKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-Finance-Demo-Key",
      "description": "Paste the privately derived connector key into the connection credential. Never supply the D365 client secret or make this an AI-filled tool parameter."
    }
  },
  "security": [
    {
      "FinanceDemoKey": []
    }
  ],
  "paths": {
